# ============================================================
#  Tunebox — configuration
#  Copie ce fichier en `.env` et remplis les deux premieres lignes.
# ============================================================

# --- Obligatoire ---------------------------------------------------------

# Code PIN qui protege l'espace parent (/admin). 4 a 8 chiffres.
# Prends-en un que ton enfant ne verra pas par-dessus ton epaule.
ADMIN_PIN=1234

# Signature des sessions parent. N'importe quelle longue chaine aleatoire :
#   openssl rand -hex 32
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# --- Reseau et stockage --------------------------------------------------

# Port d'ecoute du serveur.
PORT=8080

# Dossier des donnees : base SQLite, fichiers audio, pochettes.
# C'est le seul dossier a sauvegarder. En Docker il est monte sur /data.
DATA_DIR=./data

# Mets 1 si Tunebox est servi en HTTPS par un proxy inverse (Caddy, Nginx,
# Traefik, Tailscale serve). Le cookie de session devient alors Secure.
# Laisse 0 pour un acces direct en http:// sur le reseau local.
COOKIE_SECURE=0

# --- Docker --------------------------------------------------------------

# Image a utiliser avec docker-compose.image.yml (installation sans compilation).
# TUNEBOX_IMAGE=ghcr.io/undefinedfr/tunebox:latest

# Nom de domaine, uniquement pour le deploiement VPS avec Caddy (deploy/vps).
# TUNEBOX_DOMAIN=musique.mondomaine.fr
# TUNEBOX_EMAIL=moi@mondomaine.fr

# Mets 0 pour figer yt-dlp si une mise a jour casse les imports.
YTDLP_AUTO_UPDATE=1

# --- Optionnel : import de playlists Spotify -----------------------------
# Lecture seule, pas besoin d'un compte Premium.
# https://developer.spotify.com/dashboard -> Create app -> Client ID / Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
