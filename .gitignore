web/android/.gradle/
web/android/build/
web/android/app/build/
web/android/app/src/main/assets/public/
web/android/app/src/main/assets/capacitor.config.json
web/android/app/src/main/assets/capacitor.plugins.json
web/android/capacitor-cordova-android-plugins/
web/android/local.properties
web/ios/
*.apk
*.aab
*.keystore
*.jks
keystore.properties

